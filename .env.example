# Copy this file to .env and fill in values for your environment.
# All EXPO_PUBLIC_ vars are inlined at build time and visible in the bundle —
# never put secrets here. Tokens are stored in expo-secure-store at runtime.

# Base URL for the Slotify backend API (no trailing slash)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Google OAuth client ID (used by expo-auth-session / expo-web-browser)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
