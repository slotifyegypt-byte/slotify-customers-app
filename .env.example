# Copy to .env.local and adjust as needed. Vars must be prefixed EXPO_PUBLIC_
# to be inlined into the JS bundle (see https://docs.expo.dev/guides/environment-variables/).

EXPO_PUBLIC_API_BASE_URL=https://api.slotify-eg.com/api/v1

# Optional — crash reporting is a no-op without this
EXPO_PUBLIC_SENTRY_DSN=

# Maps (Explore screen, Home map preview) use react-native-maps — Apple Maps
# on iOS (no key needed) and Google Maps on Android (key required below).
# This is read at prebuild time by app.config.ts, so it must NOT be
# EXPO_PUBLIC_-prefixed (it should not ship inside the JS bundle).
# Get a key at https://console.cloud.google.com/google/maps-apis — enable the
# "Maps SDK for Android".
GOOGLE_MAPS_API_KEY=
