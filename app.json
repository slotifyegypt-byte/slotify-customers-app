{
  "expo": {
    "name": "Slotify",
    "slug": "slotify-customers",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./Assets/Icon Logo (1).png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "slotify",
    "splash": {
      "image": "./Assets/Icon Logo (1).png",
      "resizeMode": "contain",
      "backgroundColor": "#F0EFF7"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.slotify.customers",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Slotify uses your location to show nearby services and estimate travel times."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./Assets/Icon Logo (1).png",
        "backgroundColor": "#7C6FF0"
      },
      "package": "com.slotify.customers",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./Assets/Icon Logo (1).png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F0EFF7",
          "image": "./Assets/Icon Logo (1).png",
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
